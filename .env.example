# Password for /admin. Defaults to "admin" in local dev only; required in production.
ADMIN_PASSWORD=

# Optional: secret used to sign the admin session cookie (defaults to a hash of ADMIN_PASSWORD).
ADMIN_SECRET=

# Required on Vercel for admin saves/uploads: a GitHub token with Contents read & write access to the repo.
GITHUB_TOKEN=
GITHUB_REPO=bharmotajatin/portfolio
GITHUB_BRANCH=main
